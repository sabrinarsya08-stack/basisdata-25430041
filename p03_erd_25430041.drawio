%%{init: {'theme': 'base', 'themeVariables': { 'primaryColor': '#e8f4f8', 'primaryBorderColor': '#2b7a78', 'lineColor': '#17252a', 'textColor': '#17252a', 'fontFamily': 'Arial'}}}%%
erDiagram
    petugas ||--o{ peminjaman : melayani
    anggota ||--o{ peminjaman : melakukan
    peminjaman ||--|{ detail_peminjaman : berisi
    buku ||--o{ detail_peminjaman : tercantum
    penerbit ||--o{ pengadaan : menerima
    pengadaan ||--|{ detail_pengadaan : berisi
    buku ||--o{ detail_pengadaan : dibeli

    petugas {
        PK id_petugas "SMALLINT"
        -- kode_petugas "CHAR(3)"
        -- nama_petugas "VARCHAR(100)"
        -- peran_petugas "ENUM"
    }

    anggota {
        PK id_anggota "INT"
        -- no_anggota "CHAR(6)"
        -- nim_anggota "CHAR(10)"
        -- nama_anggota "VARCHAR(100)"
        -- prodi_anggota "VARCHAR(60)"
        -- no_hp_anggota "VARCHAR(15)"
        -- status_anggota "ENUM"
        -- tgl_daftar_anggota "DATE"
    }

    penerbit {
        PK id_penerbit "INT"
        -- nama_penerbit "VARCHAR(100)"
        -- telepon_penerbit "VARCHAR(15)"
        -- alamat_penerbit "VARCHAR(200)"
    }

    buku {
        PK id_buku "INT"
        -- kode_buku "VARCHAR(10)"
        -- judul_buku "VARCHAR(100)"
        -- kategori_buku "ENUM"
        -- stok_buku "INT"
        -- stok_min_buku "INT"
    }

    peminjaman {
        PK id_peminjaman "INT"
        -- no_peminjaman "CHAR(12)"
        -- tgl_peminjaman "DATETIME"
        FK id_petugas "SMALLINT"
        FK id_anggota "INT"
        -- tgl_batas_kembali "DATE"
    }

    detail_peminjaman {
        PK,FK id_peminjaman "INT"
        PK,FK id_buku "INT"
        -- qty_pinjam "SMALLINT"
        -- denda_keterlambatan "DECIMAL(12,2)"
    }

    pengadaan {
        PK id_pengadaan "INT"
        -- no_faktur_pengadaan "VARCHAR(20)"
        -- tgl_pengadaan "DATE"
        FK id_penerbit "INT"
        -- status_pengadaan "ENUM"
    }

    detail_pengadaan {
        PK,FK id_pengadaan "INT"
        PK,FK id_buku "INT"
        -- qty_pengadaan "INT"
        -- harga_beli_buku "DECIMAL(12,2)"
    }