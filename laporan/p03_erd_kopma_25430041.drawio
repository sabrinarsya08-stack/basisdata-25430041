vertex="1" parent="1"><mxGeometry x="992" y="913" width="180" height="24" as="geometry"/></mxCell><mxCell id="lg_keys" value="PK = kunci primer | FK = kunci tamu | PK,FK = kunci primer komposit sekaligus kunci tamu | UK = kunci unik | DP = data pribadi (akses terbatas, UU PDP) | NULL = boleh kosong" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="950" width="1120" height="26" as="geometry"/></mxCell><mxCell id="lg_read" value="Kardinalitas dibaca dari entitas di seberang ujung garis. Angka di ujung garis = batas minimum..maksimum pasangan." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="976" width="1120" height="26" as="geometry"/></mxCell><mxCell id="lg_derived" value="Satu warna per entitas. Nilai turunan (subtotal, jumlah, total nota) tidak digambar sebagai kolom; dihitung dari detail (keputusan di Pertemuan 4)." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="1002" width="1120" height="26" as="geometry"/></mxCell><mxCell id="signature" value="Sabrina Raisya Putri | NIM 25430041 | Kelas B" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;align=center;verticalAlign=middle;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1230" y="990" width="430" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>