        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;%%{init: {&#39;theme&#39;: &#39;base&#39;, &#39;themeVariables&#39;: { &#39;primaryColor&#39;: &#39;#e8f4f8&#39;, &#39;primaryBorderColor&#39;: &#39;#2b7a78&#39;, &#39;lineColor&#39;: &#39;#17252a&#39;, &#39;textColor&#39;: &#39;#17252a&#39;, &#39;fontFamily&#39;: &#39;Arial&#39;}}}%%\nerDiagram\n    petugas ||--o{ peminjaman : melayani\n    anggota ||--o{ peminjaman : melakukan\n    peminjaman ||--|{ detail_peminjaman : berisi\n    buku ||--o{ detail_peminjaman : tercantum\n    penerbit ||--o{ pengadaan : menerima\n    pengadaan ||--|{ detail_pengadaan : berisi\n    buku ||--o{ detail_pengadaan : dibeli\n\n    petugas {\n        PK id_petugas \&quot;SMALLINT\&quot;\n        -- kode_petugas \&quot;CHAR(3)\&quot;\n        -- nama_petugas \&quot;VARCHAR(100)\&quot;\n        -- peran_petugas \&quot;ENUM\&quot;\n    }\n\n    anggota {\n        PK id_anggota \&quot;INT\&quot;\n        -- no_anggota \&quot;CHAR(6)\&quot;\n        -- nim_anggota \&quot;CHAR(10)\&quot;\n        -- nama_anggota \&quot;VARCHAR(100)\&quot;\n        -- prodi_anggota \&quot;VARCHAR(60)\&quot;\n        -- no_hp_anggota \&quot;VARCHAR(15)\&quot;\n        -- status_anggota \&quot;ENUM\&quot;\n        -- tgl_daftar_anggota \&quot;DATE\&quot;\n    }\n\n    penerbit {\n        PK id_penerbit \&quot;INT\&quot;\n        -- nama_penerbit \&quot;VARCHAR(100)\&quot;\n        -- telepon_penerbit \&quot;VARCHAR(15)\&quot;\n        -- alamat_penerbit \&quot;VARCHAR(200)\&quot;\n    }\n\n    buku {\n        PK id_buku \&quot;INT\&quot;\n        -- kode_buku \&quot;VARCHAR(10)\&quot;\n        -- judul_buku \&quot;VARCHAR(100)\&quot;\n        -- kategori_buku \&quot;ENUM\&quot;\n        -- stok_buku \&quot;INT\&quot;\n        -- stok_min_buku \&quot;INT\&quot;\n    }\n\n    peminjaman {\n        PK id_peminjaman \&quot;INT\&quot;\n        -- no_peminjaman \&quot;CHAR(12)\&quot;\n        -- tgl_peminjaman \&quot;DATETIME\&quot;\n        FK id_petugas \&quot;SMALLINT\&quot;\n        FK id_anggota \&quot;INT\&quot;\n        -- tgl_batas_kembali \&quot;DATE\&quot;\n    }\n\n    detail_peminjaman {\n        PK,FK id_peminjaman \&quot;INT\&quot;\n        PK,FK id_buku \&quot;INT\&quot;\n        -- qty_pinjam \&quot;SMALLINT\&quot;\n        -- denda_keterlambatan \&quot;DECIMAL(12,2)\&quot;\n    }\n\n    pengadaan {\n        PK id_pengadaan \&quot;INT\&quot;\n        -- no_faktur_pengadaan \&quot;VARCHAR(20)\&quot;\n        -- tgl_pengadaan \&quot;DATE\&quot;\n        FK id_penerbit \&quot;INT\&quot;\n        -- status_pengadaan \&quot;ENUM\&quot;\n    }\n\n    detail_pengadaan {\n        PK,FK id_pengadaan \&quot;INT\&quot;\n        PK,FK id_buku \&quot;INT\&quot;\n        -- qty_pengadaan \&quot;INT\&quot;\n        -- harga_beli_buku \&quot;DECIMAL(12,2)\&quot;\n    }&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="jcIWZsPSK7mSJ2Y5-kMk-18">
